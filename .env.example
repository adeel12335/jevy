# The public origin this site is served from. Everything that carries an
# absolute URL — canonical link, social card, robots.txt, sitemap — is built
# from this. Set it before deploying.
VITE_SITE_URL=https://www.jevvyconstruction.com

# Optional. Where the project inquiry form posts (Formspree, Web3Forms,
# Netlify Forms, or your own handler). Leave it unset and the form drafts the
# message into the visitor's email client instead, which needs no backend.
# If you set it, add the endpoint's origin to connect-src in public/_headers
# and vercel.json, or the browser's content security policy will block it.
# VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
